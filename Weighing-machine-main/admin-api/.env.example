PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_RDS_HOST:5432/postgres?sslmode=require
# Production defaults to true. Set false only if the RDS CA is unavailable locally.
DB_SSL_REJECT_UNAUTHORIZED=false
# Required in production — use a long random string (>=24 chars), never the placeholder.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=12h
SITE_ID=WB-03
# Comma-separated allowlist. Required (non-*) in production.
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=8mb
MAX_UPLOAD_IMAGE_BYTES=5242880
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_LIMIT=20
HEAVY_RATE_LIMIT_PER_MIN=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=k1-k2
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password
# Google AI Studio key used to edit fill-vehicle camera stills for remote trips.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PDF_PHOTO_MAX_WIDTH=480
PDF_PHOTO_JPEG_QUALITY=55
